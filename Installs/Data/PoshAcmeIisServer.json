      "C:\\SCRIPTS\\Applications\\OpenSource\\PoshAcme\\IisServer\\Test-IisLEPrerequisites.ps1",
      "C:\\SCRIPTS\\Applications\\OpenSource\\PoshAcme\\IisServer\\Install-IisLE.ps1 -ImportCurrent",
      "C:\\SCRIPTS\\Applications\\OpenSource\\PoshAcme\\IisServer\\Renew-IisLE.ps1 -DeployCurrent"
    ]
  },
