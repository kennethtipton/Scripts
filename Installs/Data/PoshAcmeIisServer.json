{
  "Name": "PoshAcmeIisServer",
  "Description": "IIS role of PoshAcme: renews the server's Let's Encrypt certificates and binds each to its IIS bindings (Posh-ACME.Deploy Set-IISCertificate). Which certificate goes to which site/bindings is kept on the server (Data\\Deployments\\IisCertificates.json), edited with Add-IisCertificate.ps1; one certificate can serve several sites and a server can have several certificates. Pulls in the PoshAcme core, whose install steps run first.",
  "AppData": "C:\\SCRIPTS\\Applications\\OpenSource\\PoshAcme\\IisServer\\Data\\PoshAcmeIisServer.json",
  "DependsOn": [
    "PoshAcme"
  ],
  "Servers": [
    "srv010010037055.generationsgaither.com"
  ],
  "Install": {
